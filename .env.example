PORT=3000
ADMIN_PASSWORD=changeme123

# Timezone for the daily token reset (at local midnight). IANA name.
QUEUE_TIMEZONE=Asia/Dubai

# ---- Persistence: pick ONE of the two sections below (or neither, to fall
# back to a local JSON file with no setup) ----

# -- Local development: yourq-api + local Postgres --
# Set this to run the web app against the yourq-api (.NET) server, which talks
# to a Postgres instance on your machine. Leave the Supabase vars below blank
# when using this. Not used in production.
DEV_API_URL=http://localhost:5103

# -- Production: Supabase --
# Leave DEV_API_URL blank when deploying. Get these from Supabase -> Project
# Settings -> API. Use the SECRET key (starts with sb_secret_), not the
# publishable one.
SUPABASE_URL=
SUPABASE_KEY=
